BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
ColumnLimit: 80
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterStruct: false
  AfterEnum: false
  AfterControlStatement: true
  BeforeElse: true
  BeforeCatch: true
PointerAlignment: Right
IndentCaseLabels: false
AllowShortFunctionsOnASingleLine: None
AllowShortEnumsOnASingleLine: false
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<((sys|linux|netinet|arpa|bits|x86|unistd|fcntl|str*|std*|signal|math|errno|dirent)[/\\]?.*)>$'
    Priority: 1
    SortPriority: 0
    CaseSensitive: false

  - Regex: '^<(?!jcrt/)[^/]+/.*>$'
    Priority: 2
    SortPriority: 1
    CaseSensitive: false

  - Regex: '^<jcrt/.*>$'
    Priority: 3
    SortPriority: 2
    CaseSensitive: false
