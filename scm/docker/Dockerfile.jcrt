FROM ubuntu:22.04
MAINTAINER Junior Coder Rescue Team "junior.coder.rescue.team@gmail.com"

ENV TZ "Asia/Seoul"
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

RUN	apt-get update && \
	apt-get upgrade -y && \
	DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential \
		software-properties-common \
		python3-pip \
		python3-dev \
		python3-setuptools \
		python3-venv \
		gcc \
		git \
		make \
		cmake \
		clang-format \
		shellcheck \
        cppcheck \
		valgrind \
        gcc-arm-none-eabi \
        binutils-arm-none-eabi \
        gdb-multiarch && \
	python3 -m pip install -U pip && \
	python3 -m pip install isort==6.0.1 \
		flake8==7.3.0 \
		pylint==3.3.8 \
        black==25.1.0 && \
	apt-get autoclean -y && \
	apt-get autoremove -y && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/* && \
	rm -rf /tmp/*

CMD ["/bin/bash", "-c", "ls -al"]
