FROM ubuntu:24.04
LABEL maintainer="junior.coder.rescue.team@gmail.com"

ENV TZ="Asia/Seoul"
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive

RUN	apt-get update && \
	apt-get install -y build-essential \
		software-properties-common \
		python3-pip \
		python3-dev \
		python3-setuptools \
		python3-venv \
		gcc \
		git \
		make \
		cmake \
		clang-format \
		shellcheck \
        cppcheck \
		valgrind \
        libserialport-dev \
        gcc-arm-none-eabi \
        binutils-arm-none-eabi \
        gdb-multiarch && \
	apt-get autoclean -y && \
	apt-get autoremove -y && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/* && \
	rm -rf /tmp/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install -U pip setuptools wheel && \
    pip install isort==6.0.1 \
        flake8==7.3.0 \
        pylint==3.3.8 \
        black==25.1.0

CMD ["/bin/bash", "-c", "ls -al"]
