[Unit]
Description=Robot Daemon for Mini Project
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi4

WorkingDirectory=/home/pi4/junior-coder-rescue-team/os/pi4/hands_on
ExecStart=/home/pi4/junior-coder-rescue-team/os/pi4/hands_on/.env/bin/python /home/pi4/junior-coder-rescue-team/os/pi4/hands_on/main.py

Restart=on-failure
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
